---
import { Image } from 'astro:assets';
import simbolo from '../assets/imagens/logo-icone.png';
---

<div class="abertura" data-abertura aria-hidden="true">
  <div class="abertura__luz abertura__luz--terracota"></div>
  <div class="abertura__luz abertura__luz--verde"></div>
  <div class="abertura__textura"></div>

  <div class="abertura__conteudo">
    <div class="abertura__simbolo">
      <Image src={simbolo} alt="" width={104} height={100} loading="eager" />
    </div>
    <p class="abertura__boas-vindas">Boas-vindas à Clínica de Psicologia</p>
    <p class="abertura__marca">Transformação &amp; Equilíbrio</p>
    <span class="abertura__linha"></span>
  </div>

  <span class="abertura__dica">Toque para continuar</span>
</div>

<style>
  .abertura {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center; overflow: hidden;
    background: #F5F1EA; color: var(--texto);
    opacity: 0; visibility: hidden; pointer-events: none;
  }
  .abertura.is-ativa { opacity: 1; visibility: visible; pointer-events: auto; }
  .abertura.is-saindo {
    animation: abertura-sair .34s cubic-bezier(.55,.06,.68,.19) forwards;
    pointer-events: none;
  }
  .abertura__conteudo {
    position: relative; z-index: 3; width: min(88vw, 720px);
    display: flex; flex-direction: column; align-items: center;
    text-align: center;
  }
  .abertura__simbolo {
    width: 76px; height: 72px; margin-bottom: 24px;
    display: grid; place-items: center;
    overflow: hidden; border-radius: 50%;
    box-shadow: 0 8px 24px rgba(26,26,26,.06);
    opacity: 0; transform: translateY(12px) scale(.9);
  }
  .abertura__simbolo img { width: 108%; height: 108%; max-width: none; object-fit: cover; }
  .is-ativa .abertura__simbolo {
    animation: elemento-entrar .55s .16s cubic-bezier(.22,1,.36,1) forwards;
  }
  .abertura__boas-vindas {
    margin-bottom: 12px;
    color: var(--terracota-escuro);
    font: 500 clamp(12px, 1.3vw, 14px)/1.4 var(--sans);
    letter-spacing: .16em; text-transform: uppercase;
    opacity: 0; transform: translateY(10px) scale(.985);
  }
  .is-ativa .abertura__boas-vindas {
    animation: elemento-entrar .52s .4s cubic-bezier(.22,1,.36,1) forwards;
  }
  .abertura__marca {
    font: 400 clamp(36px, 5vw, 68px)/1.05 var(--serif);
    letter-spacing: -.025em;
    opacity: 0; transform: translateY(14px) scale(.985);
  }
  .is-ativa .abertura__marca {
    animation: elemento-entrar .56s .62s cubic-bezier(.22,1,.36,1) forwards;
  }
  .abertura__linha {
    width: 0; height: 1.5px; margin-top: 28px;
    background: linear-gradient(90deg, transparent, var(--terracota), transparent);
    opacity: 0;
  }
  .is-ativa .abertura__linha {
    animation: linha-expandir .42s .92s cubic-bezier(.22,1,.36,1) forwards;
  }
  .abertura__luz {
    position: absolute; z-index: 1; border-radius: 50%; filter: blur(2px);
    opacity: 0; transform: scale(.86);
  }
  .abertura__luz--terracota {
    width: min(78vw, 900px); aspect-ratio: 1; top: -45%; right: -18%;
    background: radial-gradient(circle, rgba(178,95,63,.14), rgba(178,95,63,0) 68%);
  }
  .abertura__luz--verde {
    width: min(62vw, 720px); aspect-ratio: 1; bottom: -42%; left: -16%;
    background: radial-gradient(circle, rgba(74,124,89,.09), rgba(74,124,89,0) 70%);
  }
  .is-ativa .abertura__luz--terracota {
    animation: luz-entrar 1.2s .05s cubic-bezier(.22,1,.36,1) forwards;
  }
  .is-ativa .abertura__luz--verde {
    animation: luz-entrar 1.2s .18s cubic-bezier(.22,1,.36,1) forwards;
  }
  .abertura__textura {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    opacity: .18;
    background-image:
      repeating-linear-gradient(0deg, rgba(26,26,26,.025) 0 1px, transparent 1px 4px),
      repeating-linear-gradient(90deg, rgba(255,255,255,.16) 0 1px, transparent 1px 5px);
    mix-blend-mode: multiply;
  }
  .abertura__dica {
    position: absolute; z-index: 3; bottom: max(22px, env(safe-area-inset-bottom));
    color: rgba(26,26,26,.48); font: 400 11px/1 var(--sans);
    letter-spacing: .08em;
    opacity: 0;
  }
  .is-ativa .abertura__dica { animation: dica-entrar .3s .85s ease-out forwards; }

  @keyframes elemento-entrar {
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @keyframes linha-expandir {
    0% { width: 0; opacity: 0; }
    100% { width: min(300px, 58vw); opacity: 1; }
  }
  @keyframes luz-entrar {
    to { opacity: 1; transform: scale(1); }
  }
  @keyframes dica-entrar { to { opacity: 1; } }
  @keyframes abertura-sair {
    0% { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(-4%); visibility: hidden; }
  }

  @media (max-width: 640px) {
    .abertura__conteudo { width: calc(100% - 40px); }
    .abertura__simbolo { width: 68px; height: 65px; margin-bottom: 22px; }
    .abertura__boas-vindas { max-width: 290px; letter-spacing: .12em; }
    .abertura__marca { max-width: 350px; }
    .abertura__luz--terracota { width: 130vw; top: -28%; right: -55%; }
    .abertura__luz--verde { width: 110vw; bottom: -27%; left: -48%; }
  }
  @media (prefers-reduced-motion: reduce) { .abertura { display: none; } }
</style>

<script>
  const abertura = document.querySelector<HTMLElement>('[data-abertura]');

  if (abertura) {
    const reduzirMovimento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pausarTeste = new URLSearchParams(window.location.search).has('intro-pause');

    if (reduzirMovimento) {
      abertura.remove();
    } else {
      document.documentElement.style.overflow = 'hidden';
      abertura.classList.add('is-ativa');

      let encerrada = false;
      const encerrar = () => {
        if (encerrada) return;
        encerrada = true;
        abertura.classList.add('is-saindo');
        document.documentElement.style.removeProperty('overflow');
        window.setTimeout(() => abertura.remove(), 360);
      };

      abertura.addEventListener('pointerdown', encerrar, { once: true });
      document.addEventListener('keydown', encerrar, { once: true });
      if (!pausarTeste) window.setTimeout(encerrar, 2500);
    }
  }
</script>
