---
const servicos = [
  {
    titulo: 'Psicoterapia Individual',
    frase: 'Um espaço só seu, toda semana, pra colocar em palavras o que anda ficando preso, ansiedade, depressão, fobias, traumas, TOC, bipolaridade e borderline são algumas das questões acompanhadas. Presencial no Tatuapé ou online, para adultos e jovens a partir dos 14 anos.',
    badges: ['Online', 'Presencial · Tatuapé'],
    destaque: false,
  },
  {
    titulo: 'Terapia de Casal',
    frase: 'Quando as conversas viram disputas (ou silêncio), um terceiro acolhedor ajuda vocês a voltar a se escutar. Pra reconstruir a comunicação, entender os ciclos de briga e decidir o caminho, juntos.',
    badges: ['Online', 'Presencial · Tatuapé'],
    destaque: false,
  },
  {
    titulo: 'Avaliação para Cirurgia Bariátrica',
    frase: 'Avaliação psicológica completa com laudo, conduzida com o cuidado e a técnica que a equipe médica exige, sem terrorismo, sem julgamento sobre a sua escolha. Também acompanhamento antes e depois da cirurgia.',
    badges: ['Com laudo'],
    destaque: true,
  },
  {
    titulo: 'Avaliação Psicológica',
    frase: 'Processos de avaliação com relatório técnico, no seu ritmo e com explicações claras em cada etapa. Você entende o que está sendo avaliado, por quê, e recebe o resultado com orientação sobre os próximos passos.',
    badges: ['Com relatório técnico'],
    destaque: false,
  },
];
---
<section class="servicos" id="servicos">
  <p class="kicker">Serviços</p>
  <h2 class="servicos__titulo" data-reveal>Como eu posso te acompanhar</h2>
  <div class="servicos__grid" data-reveal>
    {servicos.map((s) => (
      <div class:list={['card', { 'card--destaque': s.destaque }]}>
        {s.destaque && <span class="card__selo">Com laudo</span>}
        <h3 class="card__titulo">{s.titulo}</h3>
        <p class="card__frase">{s.frase}</p>
        <div class="card__badges">
          {s.badges.map((b) => <span class="badge">{b}</span>)}
        </div>
      </div>
    ))}
  </div>
  <p class="servicos__rodape">Valores: consultar diretamente · Atendimento particular (sem convênios) · Recibo para reembolso</p>
</section>
<style>
.servicos { background: var(--bg); padding: 12vh 5vw; text-align: center; }
.kicker {
  display: inline-flex; align-items: center; gap: 12px;
  font-size: 13px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase;
  color: var(--terracota-escuro); margin-bottom: 22px;
}
.kicker::before, .kicker::after { content: ''; display: block; width: 34px; height: 1.5px; background: var(--terracota-escuro); }
.servicos__titulo { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4vw, 54px); line-height: 1.12; margin-bottom: 48px; }
.servicos__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 18px;
  max-width: 1200px;
  margin: 0 auto;
  text-align: left;
}
.card {
  position: relative;
  background: var(--superficie);
  border: 1px solid var(--borda);
  border-radius: 20px;
  padding: 28px 24px;
  transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .3s ease;
}
.card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(26,26,26,0.08); }
.card--destaque { border-color: rgba(178,95,63,0.35); }
.card__selo {
  display: inline-block;
  font-size: 11.5px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase;
  color: var(--terracota-escuro);
  border: 1px solid rgba(178,95,63,0.4);
  border-radius: 999px;
  padding: 4px 12px;
  margin-bottom: 14px;
}
.card__titulo { font-family: var(--serif); font-weight: 400; font-size: 22px; margin-bottom: 10px; }
.card__frase { font-size: 14px; font-weight: 300; line-height: 1.6; color: var(--texto-suave); margin-bottom: 18px; }
.card__badges { display: flex; flex-wrap: wrap; gap: 8px; }
.badge {
  font-size: 12.5px; font-weight: 500;
  color: var(--texto);
  border: 1.5px solid var(--borda);
  background: transparent;
  border-radius: 999px;
  padding: 5px 14px;
}
.servicos__rodape { margin-top: 44px; font-size: 13.5px; font-weight: 300; color: var(--texto-suave); }
@media (prefers-reduced-motion: reduce) { .card:hover { transform: none; } }
</style>
