---
const WHATSAPP = 'https://wa.me/5511961205743';
const temas = [
  { titulo: 'Ansiedade', frase: 'Coração acelerado no trânsito, mente ensaiando conversas que ainda não aconteceram, e, mesmo assim, você não consegue parar.' },
  { titulo: 'Depressão', frase: 'Acordar, olhar o celular e já estar cansado. O que antes dava prazer hoje exige força pra começar.' },
  { titulo: 'Luto e perdas', frase: 'A vida pede que você siga, mas tem dias em que uma música, um cheiro ou uma data derrubam tudo de novo.' },
  { titulo: 'Traumas e fobias', frase: 'Evitar a rua, o elevador, o cachorro, organizar o dia inteiro em volta de algo que você prefere não encontrar.' },
  { titulo: 'TOC', frase: 'Trancar a porta e voltar três vezes pra conferir. Saber que é irracional, e não conseguir evitar o ritual.' },
  { titulo: 'Relacionamento abusivo', frase: 'Andar em ovos dentro de casa, reler mensagens pra entender o que deu errado, duvidar da própria memória.' },
  { titulo: 'Casal', frase: 'Vocês dividem o mesmo sofá e celulares diferentes. Brigas que começam na louça e terminam em silêncio por dias.' },
  { titulo: 'Autoconhecimento', frase: 'Perceber que, mesmo mudando as pessoas e os lugares, certos desfechos se repetem, e começar a investigar qual é a sua participação nesse padrão.' },
];
---
<section class="atendimento" id="atendimento">
  <p class="kicker">Atendimento</p>
  <h2 class="atendimento__titulo" data-reveal>Tratamento e acolhimento a questões como:</h2>
  <p class="atendimento__sub">Se alguma dessas frases parece com a sua semana, é um bom lugar pra começar.</p>
  <div class="atendimento__grid" id="questoes-atendidas" data-reveal>
    {temas.map((t, index) => (
      <a class:list={['card', { 'card--mobile-extra': index >= 4 }]} href={WHATSAPP} target="_blank" rel="noopener">
        <h3 class="card__titulo">{t.titulo}</h3>
        <p class="card__frase">{t.frase}</p>
      </a>
    ))}
  </div>
  <button
    class="atendimento__expandir"
    type="button"
    aria-expanded="false"
    aria-controls="questoes-atendidas"
  >
    <span class="atendimento__expandir-texto">Ver mais questões que acompanho</span>
    <span class="atendimento__expandir-icone" aria-hidden="true"></span>
  </button>
  <div class="atendimento__cta">
    <p class="atendimento__cta-frase">Se identificou? A conversa é o começo.</p>
    <a class="atendimento__cta-link" href={WHATSAPP} target="_blank" rel="noopener">Me conte o que você está vivendo →</a>
  </div>
</section>
<style>
.atendimento { background: var(--bg); padding: 12vh 5vw; text-align: center; }
.kicker {
  display: inline-flex; align-items: center; gap: 12px;
  font-size: 13px; font-weight: 500; letter-spacing: 3px; text-transform: uppercase;
  color: var(--verde-escuro); margin-bottom: 22px;
}
.kicker::before, .kicker::after { content: ''; display: block; width: 34px; height: 1.5px; background: var(--verde-escuro); }
.atendimento__titulo { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4vw, 54px); line-height: 1.12; margin-bottom: 14px; }
.atendimento__sub { font-size: 17px; font-weight: 300; color: var(--texto-suave); margin-bottom: 48px; }
.atendimento__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
  max-width: 1200px;
  margin: 0 auto;
  text-align: left;
}
.card {
  position: relative; overflow: hidden;
  background: var(--superficie);
  border: 1px solid var(--borda);
  border-radius: 20px;
  padding: 28px 24px;
  text-decoration: none; color: var(--texto);
  transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow .3s ease;
}
.card::before {
  content: ''; position: absolute; top: 0; bottom: 0; left: -80%;
  width: 55%;
  background: linear-gradient(115deg, transparent, rgba(255,255,255,0.55), transparent);
  transform: skewX(-20deg) translateX(-140%);
  pointer-events: none;
}
.card:hover, .card:focus-visible { transform: translateY(-3px); box-shadow: 0 18px 40px rgba(26,26,26,0.08); }
.card:hover::before, .card:active::before, .card:focus-visible::before { animation: shine 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
.card:active { transform: scale(0.985); }
@keyframes shine { to { transform: skewX(-20deg) translateX(340%); } }
.card__titulo { font-family: var(--serif); font-weight: 400; font-size: 22px; margin-bottom: 10px; }
.card__frase { font-size: 14px; font-weight: 300; line-height: 1.6; color: var(--texto-suave); }
.atendimento__expandir { display: none; }
.atendimento__cta { margin-top: 52px; }
.atendimento__cta-frase { font-family: var(--serif); font-style: italic; font-size: 24px; margin-bottom: 14px; }
.atendimento__cta-link { color: var(--verde-escuro); font-weight: 500; text-decoration: none; }
.atendimento__cta-link:hover, .atendimento__cta-link:focus-visible { text-decoration: underline; }
@media (min-width: 1100px) {
  .atendimento__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .atendimento__grid .card:nth-child(9) { grid-column: 2; }
}
@media (max-width: 640px) {
  .atendimento { padding: 10vh 20px; }
  .atendimento__titulo { font-size: clamp(32px, 10vw, 42px); }
  .atendimento__sub { font-size: 16px; line-height: 1.6; margin-bottom: 34px; }
  .atendimento__grid { grid-template-columns: 1fr; gap: 14px; }
  .card { padding: 24px 20px; }
  .atendimento.is-collapsible:not(.is-expanded) .card--mobile-extra { display: none; }
  .atendimento.is-collapsible.is-expanded .card--mobile-extra { animation: revelar-card .38s cubic-bezier(.22,1,.36,1) both; }
  .atendimento.is-collapsible .atendimento__expandir {
    display: inline-flex; align-items: center; justify-content: center; gap: 12px;
    width: 100%; min-height: 50px; margin: 22px auto 0; padding: 12px 20px;
    border: 1px solid rgba(53,91,67,.3); border-radius: 999px;
    background: rgba(251,248,242,.7); color: var(--verde-escuro);
    font: 500 14px/1.35 var(--sans); cursor: pointer;
    box-shadow: 0 8px 24px rgba(26,26,26,.04);
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .atendimento__expandir:hover, .atendimento__expandir:focus-visible {
    background: var(--superficie); border-color: var(--verde-principal); transform: translateY(-1px);
  }
  .atendimento__expandir-icone {
    width: 9px; height: 9px; flex: 0 0 auto;
    border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform .25s cubic-bezier(.22,1,.36,1);
  }
  .atendimento.is-expanded .atendimento__expandir-icone { transform: translateY(2px) rotate(225deg); }
  .atendimento__cta { margin-top: 42px; }
  @keyframes revelar-card {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
}
@media (prefers-reduced-motion: reduce) {
  .card:hover { transform: none; }
  .card::before { display: none; }
  .atendimento.is-collapsible.is-expanded .card--mobile-extra { animation: none; }
  .atendimento__expandir, .atendimento__expandir-icone { transition: none !important; }
}
</style>
<script>
  const secao = document.querySelector<HTMLElement>('.atendimento');
  const botao = secao?.querySelector<HTMLButtonElement>('.atendimento__expandir');
  const texto = botao?.querySelector<HTMLElement>('.atendimento__expandir-texto');
  const mobile = window.matchMedia('(max-width: 640px)');

  if (secao && botao && texto) {
    const atualizarResponsividade = () => {
      secao.classList.toggle('is-collapsible', mobile.matches);
      if (!mobile.matches) {
        secao.classList.remove('is-expanded');
        botao.setAttribute('aria-expanded', 'false');
        texto.textContent = 'Ver mais questões que acompanho';
      }
    };

    botao.addEventListener('click', () => {
      const expandido = secao.classList.toggle('is-expanded');
      botao.setAttribute('aria-expanded', String(expandido));
      texto.textContent = expandido ? 'Mostrar menos questões' : 'Ver mais questões que acompanho';
    });

    atualizarResponsividade();
    mobile.addEventListener('change', atualizarResponsividade);
  }
</script>
