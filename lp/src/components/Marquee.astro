---
const palavras = [
  'Equilíbrio',
  'Escuta',
  'Acolhimento',
  'Transformação',
  'Sem juízo',
  'Respeito ao ritmo',
  'Presencial',
  'Online',
  'Tatuapé',
  'Adultos',
  'Jovens',
  'Casais',
];

const faixa = [...palavras, ...palavras];
---

<div class="marquee" role="presentation" aria-hidden="true">
  <div class="marquee__track">
    {faixa.map((palavra, i) => (
      <span class={i % 2 === 0 ? 'marquee__palavra' : 'marquee__palavra marquee__palavra--destaque'}>
        {palavra}
        <span class="marquee__ponto"></span>
      </span>
    ))}
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--borda);
    border-bottom: 1px solid var(--borda);
    padding: 14px 0;
    background: var(--superficie);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .marquee__palavra {
    display: inline-flex;
    align-items: center;
    padding: 0 32px;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    font-weight: 500;
    color: var(--texto-suave);
    flex-shrink: 0;
    white-space: nowrap;
  }

  .marquee__palavra--destaque {
    color: var(--terracota-escuro);
  }

  .marquee__ponto {
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--borda);
    margin-left: 32px;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track { animation: none; }
  }
</style>
