---
import Layout from '../layouts/Layout.astro';
import Abertura from '../components/Abertura.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Atendimento from '../components/Atendimento.astro';
import Sobre from '../components/Sobre.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Servicos from '../components/Servicos.astro';
import Acolhimento from '../components/Acolhimento.astro';
import Localizacao from '../components/Localizacao.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Rodape from '../components/Rodape.astro';
---
<Layout title="Andréa Rosa Souza, Psicóloga no Tatuapé & Online | Transformação & Equilíbrio" description="Psicoterapia acolhedora com embasamento técnico. Adultos, jovens e casais. Presencial no Tatuapé ou online. CRP 06/136303.">
  <Abertura />
  <Header />
  <main id="conteudo-principal" tabindex="-1">
      <Hero />
      <Marquee />
      <ProvaSocial />
      <Atendimento />
      <Servicos />
      <Acolhimento />
      <Sobre />
      <ComoFunciona />
      <Faq />
      <Localizacao />
      <CtaFinal />
    </main>
  <Rodape />
</Layout>
